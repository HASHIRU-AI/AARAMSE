# Caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtualenvs and build output
.venv/
venv/
build/
dist/
*.egg-info/

# Run outputs under audit/. The measured artifacts the docs cite --
# finqa_*.{json,jsonl} and benign_adjudication.json -- stay tracked.
audit/cert_cache.json
audit/gateway.jsonl
audit/gateway_demo.jsonl
audit/demo_gateway.jsonl
audit/verify_demo.jsonl
audit/preflight.jsonl
audit/adjudicated_repair.json
audit/adjudicated_repair.jsonl
audit/e2e_smoke.jsonl
audit/e2e_gate_offline.jsonl

# Local tooling state
.claude/

# Secrets. See RESPONSIBLE_USE.md and the security rules.
.env
.env.*
settings.json
*.pem
*.key
credentials.json

# Scratch state for `examples/wildguard_benign.py --resume`. The completed
# audit artifacts are committed; this is the crash-recovery cache.
audit/*.partial.jsonl

# The full 1930-item WildGuardMix slice. WildGuardMix is gated under AI2's
# ImpACT licence, so only the 100-prompt evaluated sample is redistributed
# here. Regenerate the full corpus with scripts/build_wildguard_benign.py.
data/wildguard_benign.json

# Raw model completions retained for diagnosis. Hashed into the audit chain,
# but never committed: they are verbatim answers to prohibited queries.
audit/*.completions.jsonl
